<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      探针 APK：无 UI 交互需求，启动即跑全部探针，通过 logcat(tag=PROBE) 输出报告。
      刻意不引入任何第三方依赖（含 androidx），以保证「直接安装」与「作为 guest 导入容器」
      两种场景行为一致。
    -->
    <application
        android:name=".ProbeApplication"
        android:allowBackup="false"
        android:label="Sandbox Probe"
        android:supportsRtl="true">

        <!-- initOrder 抬高，确保它在本应用其他 Provider 之前创建（用于验证启动时序） -->
        <provider
            android:name=".ProbeProvider"
            android:authorities="com.sandbox.probe.probe"
            android:exported="false"
            android:initOrder="1000" />

        <!--
          探针主入口是 ProbeProvider（见 ProbeProvider.onCreate）。
          Activity 仅保留为手动/调试入口，并刻意使用 NoActionBar 主题：
          容器里 PhoneWindow.setDefaultIcon() 会拿宿主的 ActivityInfo.icon
          （0x7f0a0000）去 guest Resources 查 drawable，导致 NotFoundException。
          去掉 ActionBar 可绕过该调用，便于在容器内手动启动排查。
          同时声明 icon 指向系统资源，避免 0x7f 前缀。
        -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:icon="@android:drawable/sym_def_app_icon"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!--
          UiTestActivity（v1.5+）：纯 UI 排查页。
          只显示可长按选中的文本，不跑任何虚拟环境检查，也不自动 finish。

          v1.13 起**不再承担 LAUNCHER 入口**（入口给 WebViewProbeActivity）。
          原因：Gaia 这类容器里没有命令行，只能靠「点桌面图标」启动，
          所以入口必须直达要跑的那个页面。UiTestActivity 仍保留为可 am start 的调试页。
        -->
        <activity
            android:name=".UiTestActivity"
            android:exported="true"
            android:icon="@android:drawable/sym_def_app_icon"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!--
          WebViewProbeActivity（v1.9+）：用实践证明 WebView 在容器里的行为。

          W0  WebView 能否创建            WebView 自己的资源域（0x02）能否解析
          W1  loadDataWithBaseURL         渲染（不碰文件）
          W2  file 协议 + getFilesDir()   读私有目录
          W3  file 协议的 android_asset   assets（AssetManager 路径）
          W4  file 协议 + getDataDir/files  dataDir 形式
          W5  ApplicationInfo.getAllApkPaths()  AOSP WebViewFactory 用它加 shared library
          W6  宿主 getAssets() 里有没有 WebView 资源  验证 addAssetPathAsSharedLibrary 是否生效
          W7  0x02 域资源能否解析         直接验 popup 崩溃那个 0x20c0006
          W14 非沙箱路径（adb push 的文件）   对照：证明根因在「沙箱路径」
          W15 沙箱路径 + query             测是否按 URL 末段判扩展名
          W16 沙箱 .txt                    测「只看扩展名」
          W17 沙箱路径 + adb 放的文件       排除「谁写的文件」这个变量
          W18 容器私有目录根                排除 virtual/data 路径段
          W19 被容器重定向的 /sdcard        测重定向路径的 MIME
          W20 内容以 GIF89a 开头            ⭐ 判定 MIME 是否走「内容嗅探」
          W30 反射包装 WebViewClient        预演容器的修复方案（补 MIME）

          v1.13 起它承担 **LAUNCHER 入口**：在 Gaia 这类没有命令行的容器里，
          点桌面图标 = 打开本页 = 自动跑完所有 W 实验，结果直接显示在屏幕上
          （结果同时在 wvprobe-result.txt 与 `logcat -s WVP`）。

          主题用 NoActionBar，避免容器里 setDefaultIcon 去 guest Resources 查 0x7f 图标。

          注意：XML 注释里不能出现双连字符（XML 规范），所以上面用中文描述代替了
          命令行参数写法，也不要写三个点之类的路径通配。
        -->
        <activity
            android:name=".WebViewProbeActivity"
            android:exported="true"
            android:icon="@android:drawable/sym_def_app_icon"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
