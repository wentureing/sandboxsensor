<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      探针 APK：无 UI 交互需求，启动即跑全部探针，通过 logcat(tag=PROBE) 输出报告。
      刻意不引入任何第三方依赖（含 androidx），以保证「直接安装」与「作为 guest 导入容器」
      两种场景行为一致。
    -->
    <application
        android:name=".ProbeApplication"
        android:allowBackup="false"
        android:label="Sandbox Probe"
        android:supportsRtl="true">

        <!-- initOrder 抬高，确保它在本应用其他 Provider 之前创建（用于验证启动时序） -->
        <provider
            android:name=".ProbeProvider"
            android:authorities="com.sandbox.probe.probe"
            android:exported="false"
            android:initOrder="1000" />

        <!--
          探针主入口是 ProbeProvider（见 ProbeProvider.onCreate）。
          Activity 仅保留为手动/调试入口，并刻意使用 NoActionBar 主题：
          容器里 PhoneWindow.setDefaultIcon() 会拿宿主的 ActivityInfo.icon
          （0x7f0a0000）去 guest Resources 查 drawable，导致 NotFoundException。
          去掉 ActionBar 可绕过该调用，便于在容器内手动启动排查。
          同时声明 icon 指向系统资源，避免 0x7f 前缀。
        -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:icon="@android:drawable/sym_def_app_icon"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!--
          UiTestActivity（v1.5+）：纯 UI 排查页。
          只显示可长按选中的文本，不跑任何虚拟环境检查，也不自动 finish。

          重要：它承担 **LAUNCHER 入口**。
          原因：容器（NEXTVM）在启动 guest 时只解析 LAUNCHER 组件，
          `am start -n <pkg>/.SomeActivity` 会被劫持成 LAUNCHER 那个 Activity
          （实测：指定 UiTestActivity，实际 Displayed 的是 ProbeActivity）。
          所以把 LAUNCHER 放在这里，才能从容器卡片/am start 直达本页。
          探针本体仍由 ProbeProvider 自动触发，不依赖 Activity 入口。
        -->
        <activity
            android:name=".UiTestActivity"
            android:exported="true"
            android:icon="@android:drawable/sym_def_app_icon"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
