+        // ===== 方案A（实验，可回退）：宿主 external 兜底 =====
+        // 背景：VirtualContext.getOpPackageName() 必须返回宿主包名（appops 归因需要），
+        // 但 via 等应用会用它拼 external 路径：
+        //   Environment.getExternalStorageDirectory() + "/Android/data/" + getOpPackageName() + "/files/..."
+        // 结果是 .../data/com.nextvm.app/... —— 落在宿主，不在任何规则内。
+        // 实测后果：via 保存 .mht 走 getExternalFilesDir（沙箱），但"离线"列表列宿主目录（空），
+        // 于是"保存成功却看不到"（见 docs/输出/记录/记录-via离线保存路径不一致.md）。
+        //
+        // 为什么不自噬：本方法只在 guest 进程执行（主进程在 initNativeHooks 就被 P0-3 跳过），
+        // 规则是进程级，容器主进程看不到它。详见 docs/设计/设计-按进程区分的宿主路径兜底.md。
+        //
+        // 回退方式：删除本段 + HostExternalRedirect 相关代码，或 git revert 对应 commit。
+        if (HOST_EXTERNAL_FALLBACK) {
+            val hostExtDir = "$sandboxDataDir/host_ext/"
+            addPathRedirection(HOST_EXT_PREFIX_A, hostExtDir)
+            addPathRedirection(HOST_EXT_PREFIX_B, hostExtDir)
+            // 预建目录：避免 ensureDir 那类"登记成功但不存在"的问题
+            runCatching {
+                java.io.File("$sandboxDataDir/host_ext").mkdirs()
+            }
+            Timber.tag(TAG).i(
+                "Host external fallback ON: %s|%s -> %s",
+                HOST_EXT_PREFIX_A, HOST_EXT_PREFIX_B, hostExtDir
+            )
+        }
+
         Timber.tag(TAG).d("App redirections set for $guestPackageName ($instanceId)")
     }
 
