+// ---- 临时取证（2026-11-28）：定位 WebView 的读取者 ----
+// 仅在 NS_HOOK_OPEN_DIAG=1 的诊断构建里使用：记录"谁 open 了 wvprobe 文件"。
+// 日志用 raw syscall 写，避免递归进 hook；路径过滤用 strstr，常规 I/O 只多两次比较。
+// 运行时开关：debug.nextvm.openDiag=1（诊断后关闭；不设编译宏，避免改 CMake）
+static bool ns_open_diag_enabled() {
+    static int cached = -1;
+    if (cached < 0) {
+        char v[PROP_VALUE_MAX] = {0};
+        __system_property_get("debug.nextvm.openDiag", v);
+        cached = (v[0] == '1') ? 1 : 0;
+    }
+    return cached != 0;
+}
+static void diag_caller(void* ret_addr, char* buf, size_t len);
+static void wv_read_trace(const char* fn, const char* path, int fd, int err) {
+    if (path == nullptr) return;
+    if (strstr(path, "wvprobe") == nullptr) return;
+    char who[128] = "?";
+    diag_caller(__builtin_return_address(0), who, sizeof(who));
+    char line[640];
+    int n = snprintf(line, sizeof(line), "%s pid=%d tid=%d fd=%d err=%d who=%s path=%s\n",
+                     fn, getpid(), gettid(), fd, err, who, path);
+    if (n <= 0) return;
+    int f = static_cast<int>(syscall(SYS_openat, AT_FDCWD,
+            "/data/user/0/com.nextvm.app/files/webview-read.log",
+            O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644));
+    if (f < 0) return;
+    syscall(SYS_write, f, line, static_cast<size_t>(n));
+    syscall(SYS_close, f);
+}
+
